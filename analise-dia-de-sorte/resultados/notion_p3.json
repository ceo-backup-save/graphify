 false, "color": "default"}}]}}, {"object": "block", "type": "bulleted_list_item", "bulleted_list_item": {"rich_text": [{"type": "text", "text": {"content": "Base exata:"}, "annotations": {"bold": true}}, {"type": "text", "text": {"content": " 2.629.575 combinações possíveis de 7 dezenas foram avaliadas para gerar a coluna “Esperado” (distribuição exata do azar, não aproximação)."}, "annotations": {"bold": false, "code": false, "color": "default"}}]}}, {"object": "block", "type": "bulleted_list_item", "bulleted_list_item": {"rich_text": [{"type": "text", "text": {"content": "Teste:"}, "annotations": {"bold": true}}, {"type": "text", "text": {"content": " qui-quadrado com agrupamento de caudas raras (esperado < 5), nível de 5%. Nenhum tópico rejeitou a aleatoriedade (menor p: 0,055 em grupos)."}, "annotations": {"bold": false, "code": false, "color": "default"}}]}}, {"object": "block", "type": "bulleted_list_item", "bulleted_list_item": {"rich_text": [{"type": "text", "text": {"content": "Arquivos:"}, "annotations": {"bold": true}}, {"type": "text", "text": {"content": " relatorio.html e relatorio.md (relatório completo), resultados/analise.json, resultados/tab_1..6_*.csv (uma tabela por tópico), analise.py e fetch_caixa.py."}, "annotations": {"bold": false, "code": false, "color": "default"}}]}}, {"object": "block", "type": "callout", "callout": {"rich_text": [{"type": "text", "text": {"content": "Nenhum desses padrões aumenta a chance de acerto: qualquer jogo de 7 dezenas tem 1 chance em 2.629.575. Os padrões servem para organizar e filtrar jogos, não para prever resultados. Jogue com responsabilidade (18+)."}, "annotations": {"bold": false, "code": false, "color": "default"}}], "icon": {"type": "emoji", "emoji": "⚠️"}, "color": "yellow_background"}}]}